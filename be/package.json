  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "build:vercel": "prisma generate && esbuild src/vercel.ts --bundle --platform=node --format=cjs --target=node20 --outfile=api/index.js --external:@prisma/client --external:.prisma/client --footer:js=\"module.exports = module.exports.default;\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
